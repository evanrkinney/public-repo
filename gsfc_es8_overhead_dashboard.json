{
  "version": "1.1.0",
  "title": "GSFC \u00b7 ES8 Overwatch (PNC Power Link)",
  "description": "Overhead TV dashboard for the Global Security Fusion Center: ES8 finding posture, rolling 8h closure activity, top closer, and top firing alert.",
  "theme": "dark",
  "defaults": {
    "dataSources": {
      "ds.search": {
        "options": {
          "queryParameters": {
            "earliest": "-7d@d",
            "latest": "now"
          }
        }
      }
    }
  },
  "inputs": {},
  "dataSources": {
    "ds_base": {
      "type": "ds.search",
      "name": "ES8 Findings Base",
      "options": {
        "query": "| from datamodel:\"Findings.All_Findings\"\n| eval _status = lower(coalesce('All_Findings.status_label', 'All_Findings.status', status_label, status))\n| eval severity = lower(coalesce('All_Findings.severity', severity, urgency, \"informational\"))\n| eval owner    = coalesce('All_Findings.owner', owner, \"unassigned\")\n| eval rule     = coalesce('All_Findings.search_name', search_name, source, \"unknown\")\n| eval mod_time = coalesce('All_Findings.mod_time', mod_time, _time)\n| eval status_group = case(\n        match(_status, \"(new|open|unassigned|in.?progress|pending|assigned|investigat)\"), \"open\",\n        match(_status, \"(closed|resolved|benign|true.?positive|false.?positive)\"),         \"closed\",\n        true(), \"other\")\n| eval is_open_now      = if(status_group=\"open\", 1, 0)\n| eval is_closed_recent = if(status_group=\"closed\" AND mod_time >= relative_time(now(),\"-8h\"), 1, 0)\n| eval is_fired_recent  = if(_time >= relative_time(now(),\"-8h\"), 1, 0)\n| eval sev_rank = case(severity=\"critical\",1, severity=\"high\",2, severity=\"medium\",3, severity=\"low\",4, true(),5)",
        "queryParameters": {
          "earliest": "-7d@d",
          "latest": "now"
        },
        "refresh": "5m",
        "refreshType": "delay"
      }
    },
    "ds_open_critical": {
      "type": "ds.chain",
      "name": "Open Critical",
      "options": {
        "extend": "ds_base",
        "query": "| search is_open_now=1 severity=\"critical\" | stats count"
      }
    },
    "ds_open_high": {
      "type": "ds.chain",
      "name": "Open High",
      "options": {
        "extend": "ds_base",
        "query": "| search is_open_now=1 severity=\"high\" | stats count"
      }
    },
    "ds_open_medium": {
      "type": "ds.chain",
      "name": "Open Medium",
      "options": {
        "extend": "ds_base",
        "query": "| search is_open_now=1 severity=\"medium\" | stats count"
      }
    },
    "ds_open_low": {
      "type": "ds.chain",
      "name": "Open Low",
      "options": {
        "extend": "ds_base",
        "query": "| search is_open_now=1 severity=\"low\" | stats count"
      }
    },
    "ds_open_info": {
      "type": "ds.chain",
      "name": "Open Informational",
      "options": {
        "extend": "ds_base",
        "query": "| search is_open_now=1 severity=\"informational\" | stats count"
      }
    },
    "ds_closed_8h": {
      "type": "ds.chain",
      "name": "Closed in 8h",
      "options": {
        "extend": "ds_base",
        "query": "| search is_closed_recent=1 | stats count"
      }
    },
    "ds_closed_8h_spark": {
      "type": "ds.chain",
      "name": "Closed 8h sparkline",
      "options": {
        "extend": "ds_base",
        "query": "| search status_group=closed mod_time>=relative_time(now(),\"-8h\")\n| eval bucket = relative_time(mod_time, \"@30m\")\n| stats count by bucket\n| sort 0 bucket"
      }
    },
    "ds_top_owner": {
      "type": "ds.chain",
      "name": "Top Owner 8h",
      "options": {
        "extend": "ds_base",
        "query": "| search is_closed_recent=1\n| stats count by owner\n| sort - count\n| head 1\n| eval label=owner, value=count\n| fields label value"
      }
    },
    "ds_top_owner_table": {
      "type": "ds.chain",
      "name": "Owner leaderboard",
      "options": {
        "extend": "ds_base",
        "query": "| search is_closed_recent=1 owner!=\"unassigned\"\n| stats count as \"Closed\" by owner\n| sort - Closed\n| head 5\n| rename owner as \"Owner\""
      }
    },
    "ds_top_alert": {
      "type": "ds.chain",
      "name": "Top Alert 8h",
      "options": {
        "extend": "ds_base",
        "query": "| search is_fired_recent=1\n| stats count by rule\n| sort - count\n| head 1\n| eval label=rule, value=count\n| fields label value"
      }
    },
    "ds_top_alerts_table": {
      "type": "ds.chain",
      "name": "Top alerts table",
      "options": {
        "extend": "ds_base",
        "query": "| search is_fired_recent=1\n| stats count as \"Fired\" by rule severity\n| sort - Fired\n| head 6\n| eval Severity = case(severity=\"critical\",\"Critical\",\n                       severity=\"high\",\"High\",\n                       severity=\"medium\",\"Medium\",\n                       severity=\"low\",\"Low\",\n                       true(),\"Informational\")\n| rename rule as \"Rule\"\n| fields Rule Severity Fired"
      }
    },
    "ds_timeline": {
      "type": "ds.chain",
      "name": "Findings timeline",
      "options": {
        "extend": "ds_base",
        "query": "| bucket _time span=15m\n| eval Severity = case(severity=\"critical\",\"Critical\",\n                       severity=\"high\",\"High\",\n                       severity=\"medium\",\"Medium\",\n                       severity=\"low\",\"Low\",\n                       true(),\"Informational\")\n| chart count over _time by Severity\n| eval Critical      = if(isnull('Critical'),0,'Critical'),\n       High          = if(isnull('High'),0,'High'),\n       Medium        = if(isnull('Medium'),0,'Medium'),\n       Low           = if(isnull('Low'),0,'Low'),\n       Informational = if(isnull('Informational'),0,'Informational')\n| fields _time Critical High Medium Low Informational\n| fillnull value=0"
      }
    }
  },
